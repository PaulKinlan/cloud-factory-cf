{
  "name": "cloud-factory-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native autonomous SDLC agent cloud: Pi-inspired dual-runtime agent SDK on Durable Objects",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:changed": "npm run test:changed --workspaces --if-present",
    "test:file": "npm run test:file --workspaces --if-present",
    "dev": "npm run dev -w @factory-cloud/worker",
    "deploy": "npm run deploy -w @factory-cloud/worker",
    "ci": "npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
