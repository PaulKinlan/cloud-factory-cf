/**
 * Wrangler configuration for Cloud Factory CF.
 *
 * One worker per deployment; each repository (org/repo) that the cloud is
 * installed on gets its own `RepoCoordinator` Durable Object, addressed by
 * `idFromName("<org>/<repo>")`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-factory-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The agent canvas (apps/web) is served from this same origin. The Worker runs
  // for every request (`run_worker_first`) and delegates non-API paths to the
  // ASSETS binding, so there is exactly one routing path to reason about and to
  // test - see the asset fallback at the end of `fetch`.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_COORDINATOR",
        "class_name": "RepoCoordinator"
      },
      {
        "name": "CREDENTIAL_BROKER",
        "class_name": "CredentialBroker"
      },
      {
        "name": "ORG_COORDINATOR",
        "class_name": "OrgCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoCoordinator"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CredentialBroker"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OrgCoordinator"]
    }
  ]
}
