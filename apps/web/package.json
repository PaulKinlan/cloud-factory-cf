{
  "name": "@factory-cloud/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isocan-style infinite canvas for wiring agents, event sources, memory hubs and action sinks",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
