    "test:file": "vitest run",
    "deploy": "wrangler deploy -c wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  }
}
